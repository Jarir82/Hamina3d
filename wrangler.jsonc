{
  // Getaway in Hamina – Cloudflare Workers -asetukset
  "name": "getaway-in-hamina",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "getaway-scores",
      // VAIHDA TÄHÄN oman D1-tietokantasi Database ID (Cloudflare → Storage & Databases → D1)
      "database_id": "LIITA-TAHAN-DATABASE-ID"
    }
  ]
}
